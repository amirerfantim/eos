# Copy to `.env` and adjust as needed. `.env` is gitignored.

# --- Postgres (db service) ---
POSTGRES_USER=eos
POSTGRES_PASSWORD=eos
POSTGRES_DB=eos

# --- Backend ---
# Async SQLAlchemy URL pointing at the `db` service on the compose network.
DATABASE_URL=postgresql+asyncpg://eos:eos@db:5432/eos

# JSON array of browser origins allowed to call the API.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
